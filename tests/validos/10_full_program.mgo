package main;

type Persona struct {
    nombre string;
    edad int;
};

func doble(x int) int {
    return x * 2;
};

func mostrarPersona(p Persona) {
    println(p.nombre);
    println(p.edad);
};

func main() {
    var p Persona;
    p.nombre = `Ana`;
    p.edad = 20;

    var numeros [3]int;
    numeros[0] = 1;
    numeros[1] = 2;
    numeros[2] = 3;

    var resultado int = doble(numeros[1]);

    if resultado > 3 {
        println(resultado);
    } else {
        println(0);
    };

    for i := 0; i < len(numeros); i++ {
        println(numeros[i]);
    };

    mostrarPersona(p);
};
